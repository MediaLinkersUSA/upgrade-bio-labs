# --------------------------------------------------------------- Payments
# This storefront does NOT process payments and holds no payment credentials.
# Card orders are recorded here, then handed to the WordPress payment site
# (UBL Stripe Connect Pro) with the new order's database id.
#
# Both values have working defaults in src/lib/payment.ts; set them to point at
# a staging payment site, or if either address ever changes.

# The order id is appended as ?order_id=<uuid>.
NEXT_PUBLIC_PAYMENT_URL=https://upgradebiolabservices.com/strip-payment/

# Where the payment site returns the customer once payment succeeds. Passed
# along as ?return_url= so the payment site does not have to hardcode it.
NEXT_PUBLIC_PAYMENT_RETURN_URL=https://upgradebiolabs.com/thank-you

# -------------------------------------------------------------- Supabase
# Project Settings -> API. The URL is public; the service-role key is NOT and
# must never be prefixed NEXT_PUBLIC_ or imported into a client component.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase renamed this key: it is the "Secret key" (sb_secret_...) in the
# current dashboard, and was called "service_role" (eyJ...) previously. Either
# works here; the env var name is unchanged.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional. Only needed if you later read approved reviews from the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# -------------------------------------------------------------- Admin
# Gates /admin. 8 characters minimum. With this unset the dashboard is
# unreachable, which is the safe default for an unconfigured deploy.
ADMIN_PASSWORD=

# ------------------------------------------------- legacy customer blocklist
# Comma-separated one-way hashes of customers from the old WooCommerce store,
# so the first-order 25% code cannot be claimed by an existing customer.
# Generated by scripts/build-legacy-blocklist.mjs.
#
# NOT in the repository, and must not be committed: these are unsalted hashes
# of low-entropy values, so anyone with a list of email addresses could test
# membership and recover the customer list. Unset, every address reads as new.
LEGACY_CUSTOMER_HASHES=
